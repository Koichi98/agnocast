<launch>
    <arg name="node_name" default="rclcpp_pubsub_test_node" />
    <arg name="topic_count" default="1" />
    <arg name="pub_topic_prefix" default="/my_pub_topic" />
    <arg name="sub_topic_prefix" default="/my_sub_topic" />

    <node pkg="agnocast_sample_application" exec="rclcpp_pubsub_test" name="$(var node_name)" output="screen">
        <param name="publish_count" value="$(var topic_count)" />
        <param name="pub_topic_prefix" value="$(var pub_topic_prefix)" />
        <param name="sub_topic_prefix" value="$(var sub_topic_prefix)" />
    </node>
</launch>
